# Shared Chert frontend. Copy to .env and chmod 600 .env, or run ./setup.sh.
# Leave optional values blank to use the defaults. Never commit .env.
CHERT_BACKEND=both
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_CODEX_CHANNEL_ID=
DISCORD_CLAUDE_CHANNEL_ID=
DISCORD_CODEX_BROADCAST_CHANNEL_ID=
DISCORD_CODEX_CHAT_CHANNEL_ID=
DISCORD_BROADCAST_CHANNEL_ID=
DISCORD_CHAT_CHANNEL_ID=
# Set 0 to keep #claude configured while no Claude account is signed in.
CLAUDE_ENABLED=1
# Defaults to the Discord server owner. All commands and replies are owner-only
# unless a user is explicitly added to SPAWN_ALLOW_USERS.
DISCORD_OWNER_ID=
SPAWN_ALLOW_USERS=
PYTHONUNBUFFERED=1

# Existing project directories beneath this root are available to /codex project.
# Default: ~/projects (created by setup.sh).
PROJECT_ROOT=
CODEX_BIN=
# Blank: use your logged-in Codex CLI's configured model and reasoning effort.
CODEX_MODEL=
CODEX_EFFORT=
CODEX_SANDBOX=workspace-write
CODEX_NETWORK_ACCESS=0
CODEX_TURN_TIMEOUT=10800
# Defaults are relative to the Chert working directory.
CODEX_STATE_FILE=private/codex-state.json
CODEX_LOG_DIR=private/codex-logs
# Discover existing user-facing sessions in the running local Codex app-server.
CODEX_DISCOVER=1
CODEX_DISCOVERY_INTERVAL=5
# Blank: $CODEX_HOME/app-server-control/app-server-control.sock
# (CODEX_HOME defaults to ~/.codex). The runtime service reuses a running daemon.
CODEX_APP_SERVER_SOCKET=
CODEX_CHAT_LOG=
CODEX_PROMPT_CHANNEL_ID=
CODEX_PROMPT_TARGET=
# For the original backend, see docs/claude.env.example and docs/claude-backend.md.
