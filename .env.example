# Chert's Codex backend. Copy to .env and chmod 600 .env, or run ./setup.sh.
# Leave optional values blank to use the defaults. Never commit .env.
CHERT_BACKEND=codex
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Defaults to the Discord server owner. All commands and replies are owner-only
# unless a user is explicitly added to SPAWN_ALLOW_USERS.
DISCORD_OWNER_ID=
SPAWN_ALLOW_USERS=
PYTHONUNBUFFERED=1

# Existing project directories beneath this root are available to /codex project.
# Default: ~/projects (created by setup.sh).
PROJECT_ROOT=
CODEX_BIN=
# Blank: use your logged-in Codex CLI's configured model and reasoning effort.
CODEX_MODEL=
CODEX_EFFORT=
CODEX_SANDBOX=workspace-write
CODEX_NETWORK_ACCESS=0
CODEX_TURN_TIMEOUT=10800
# Defaults are relative to the Chert working directory.
CODEX_STATE_FILE=private/codex-state.json
CODEX_LOG_DIR=private/codex-logs
# For the original backend, see docs/claude.env.example and docs/claude-backend.md.
